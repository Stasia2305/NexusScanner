<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nexusscan.controller.UserController"
      style="-fx-background-color: #f0f2f5;">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <VBox spacing="20.0" alignment="CENTER" styleClass="card" maxWidth="400">
        <Label text="User Dashboard" styleClass="header-label"/>
        <Label text="Prepare for scanning session" style="-fx-text-fill: #666;"/>
        
        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="300">
            <Label text="Select Scanning Profile" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="profileComboBox" maxWidth="Infinity" promptText="Choose a profile..."/>
        </VBox>
        
        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="300">
            <Label text="Box Identifier" style="-fx-font-weight: bold;"/>
            <TextField fx:id="boxIdField" promptText="Enter Box ID (e.g., BOX-001)" maxWidth="Infinity"/>
        </VBox>
        
        <Button text="Initialize Scanning" onAction="#onStartScanningClick" styleClass="button-primary" maxWidth="300" defaultButton="true"/>
        
        <Separator style="-fx-padding: 10 0 10 0;"/>
        
        <Button text="Logout" onAction="#onLogoutClick" styleClass="button-danger" maxWidth="300"/>
    </VBox>
    
    <Label text="Connected as: User" fx:id="connectionLabel" style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
</VBox>
