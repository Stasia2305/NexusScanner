<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nexusscan.controller.UserController"
      style="-fx-background-color: #f0f2f5;">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <VBox spacing="25.0" alignment="CENTER" styleClass="card" maxWidth="450">
        <VBox spacing="5" alignment="CENTER">
            <Label text="User Dashboard" styleClass="header-label"/>
            <Label text="Configure your scanning session" style="-fx-text-fill: -text-muted;"/>
        </VBox>
        
        <Separator/>

        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="350">
            <Label text="Scanning Profile" style="-fx-font-weight: bold; -fx-text-fill: -text-main;"/>
            <ComboBox fx:id="profileComboBox" maxWidth="Infinity" promptText="Select an assigned profile..."/>
        </VBox>
        
        <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="350">
            <Label text="Box Identifier" style="-fx-font-weight: bold; -fx-text-fill: -text-main;"/>
            <TextField fx:id="boxIdField" promptText="e.g. B-2024-001" maxWidth="Infinity"/>
        </VBox>
        
        <Button text="Start Scanning Session" onAction="#onStartScanningClick" styleClass="button-primary" maxWidth="350" defaultButton="true" prefHeight="45"/>
        
        <Separator style="-fx-padding: 10 0 10 0;"/>
        
        <Button text="Logout" onAction="#onLogoutClick" styleClass="button-danger" maxWidth="350"/>
    </VBox>
    
    <Label text="Connected as: User" fx:id="connectionLabel" style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
</VBox>
