<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox alignment="TOP_CENTER" spacing="30.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nexusscan.GUI.UserController"
      style="-fx-background-color: #f8fafc;">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" maxWidth="1000" spacing="20">
        <VBox>
            <Label text="NexusScan" styleClass="header-label"/>
            <Label text="Document Scanning Portal" style="-fx-text-fill: -text-muted; -fx-font-size: 13px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="connectionLabel" text="user" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Label text="Scanner" style="-fx-text-fill: -text-muted; -fx-font-size: 11px;"/>
            </VBox>
            <Button text="Logout" onAction="#onLogoutClick" styleClass="button-danger"/>
        </HBox>
    </HBox>

    <VBox spacing="30" maxWidth="1000">
        <VBox alignment="CENTER" spacing="10">
            <Label text="Start Scanning Session" styleClass="header-label" style="-fx-font-size: 32px;"/>
            <Label text="Select a scanning profile and enter the box identifier to begin" style="-fx-text-fill: -text-muted; -fx-font-size: 16px;"/>
        </VBox>

        <VBox spacing="25" styleClass="card" maxWidth="800" alignment="TOP_CENTER" VBox.vgrow="NEVER">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Scanning Configuration" styleClass="subheader-label"/>
            </HBox>
            <Label text="Configure your scanning session settings" style="-fx-text-fill: -text-muted;"/>
            
            <VBox spacing="20" maxWidth="600">
                <VBox spacing="8">
                    <Label text="Select Scanning Profile *" style="-fx-font-weight: 600;"/>
                    <ComboBox fx:id="profileComboBox" maxWidth="Infinity" promptText="Choose a scanning profile..."/>
                </VBox>
                
                <VBox spacing="8">
                    <Label text="Box Identifier *" style="-fx-font-weight: 600;"/>
                    <TextField fx:id="boxIdField" promptText="e.g., BOX-2024-001" maxWidth="Infinity"/>
                    <Label text="Enter the unique identifier for the box you're scanning" style="-fx-text-fill: -text-muted; -fx-font-size: 12px;"/>
                </VBox>
                
                <Button text="Start Scanning Session" onAction="#onStartScanningClick" styleClass="button-primary" maxWidth="Infinity" prefHeight="50" style="-fx-font-size: 15px;"/>
            </VBox>
        </VBox>
    </VBox>
</VBox>
