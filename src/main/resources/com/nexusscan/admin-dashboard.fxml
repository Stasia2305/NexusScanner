<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.nexusscan.GUI.AdminController"
      style="-fx-background-color: #f8fafc;">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox>
            <Label text="NexusScan Admin" styleClass="header-label"/>
            <Label text="Digital Archive Management" style="-fx-text-fill: -text-muted; -fx-font-size: 13px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <VBox alignment="CENTER_RIGHT">
                <Label fx:id="adminLabel" text="admin" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Label text="Administrator" style="-fx-text-fill: -text-muted; -fx-font-size: 11px;"/>
            </VBox>
            <Button text="Logout" onAction="#onLogoutClick" styleClass="button-danger"/>
        </HBox>
    </HBox>
    
    <TabPane VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <!-- USERS TAB -->
        <Tab text="Users" closable="false">
            <VBox spacing="20" style="-fx-padding: 20 0 0 0;">
                <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Manage Users" styleClass="subheader-label"/>
                    </HBox>
                    <Label text="View and manage all system users and their permissions" style="-fx-text-fill: -text-muted;"/>
                    
                    <TextField fx:id="userSearchField" promptText="Search users by username or email..." styleClass="search-field"/>
                    
                    <ListView fx:id="userListView" VBox.vgrow="ALWAYS"/>
                    
                    <HBox spacing="10" fx:id="userDetailsBox" disable="true" alignment="CENTER_LEFT">
                        <Label text="Selected:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="selectedUserLabel" text="None"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="quickProfileComboBox" promptText="Assign Profile" prefWidth="200"/>
                        <Button text="Assign" onAction="#onQuickAssignClick" styleClass="button-primary"/>
                        <Button text="Delete User" onAction="#onDeleteUserClick" styleClass="button-danger"/>
                    </HBox>
                    <Label text="Assigned Profiles:" style="-fx-font-weight: 600;"/>
                    <ListView fx:id="assignedProfilesListView" VBox.vgrow="ALWAYS" minHeight="200" maxHeight="300"/>
                    <Button text="Remove Selected Assignment" onAction="#onRemoveAssignmentClick" styleClass="button-danger" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </Tab>

        <!-- PROFILES TAB -->
        <Tab text="Profiles" closable="false">
            <VBox spacing="20" style="-fx-padding: 20 0 0 0;">
                <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                    <Label text="Manage Scanning Profiles" styleClass="subheader-label"/>
                    <Label text="Configure and manage scanning profiles for different document types" style="-fx-text-fill: -text-muted;"/>
                    
                    <TextField fx:id="profileSearchField" promptText="Search profiles..." styleClass="search-field"/>
                    <ListView fx:id="profileListView" VBox.vgrow="ALWAYS"/>
                    <Button text="Delete Profile" onAction="#onDeleteProfileClick" styleClass="button-danger" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </Tab>

        <!-- NEW USER TAB -->
        <Tab text="New User" closable="false">
            <VBox spacing="20" style="-fx-padding: 20 0 0 0;" alignment="TOP_CENTER">
                <VBox spacing="20" styleClass="card" maxWidth="600">
                    <Label text="Register New User" styleClass="subheader-label"/>
                    <Label text="Create a new user account and assign scanning profiles" style="-fx-text-fill: -text-muted;"/>
                    
                    <GridPane hgap="20" vgap="15">
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0" HBox.hgrow="ALWAYS">
                            <Label text="Username *" style="-fx-font-weight: 600;"/>
                            <TextField fx:id="newUsernameField" promptText="Enter username"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0" HBox.hgrow="ALWAYS">
                            <Label text="Email *" style="-fx-font-weight: 600;"/>
                            <TextField fx:id="newEmailField" promptText="user@example.com"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Password *" style="-fx-font-weight: 600;"/>
                            <PasswordField fx:id="newPasswordField" promptText="Enter password"/>
                        </VBox>
                        <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Role *" style="-fx-font-weight: 600;"/>
                            <ComboBox fx:id="roleComboBox" promptText="User" maxWidth="Infinity"/>
                        </VBox>
                    </GridPane>
                    
                    <HBox spacing="10">
                        <Button text="Register User" onAction="#onAddUserClick" styleClass="button-primary" prefWidth="120"/>
                        <Button text="Clear Form" styleClass="button-secondary" prefWidth="100"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>

        <!-- NEW PROFILE TAB -->
        <Tab text="New Profile" closable="false">
            <VBox spacing="20" style="-fx-padding: 20 0 0 0;" alignment="TOP_CENTER">
                <VBox spacing="20" styleClass="card" maxWidth="600">
                    <Label text="Register New Scanning Profile" styleClass="subheader-label"/>
                    <Label text="Create a new scanning profile for a specific document type" style="-fx-text-fill: -text-muted;"/>
                    
                    <VBox spacing="15">
                        <VBox spacing="5">
                            <Label text="Profile Name *" style="-fx-font-weight: 600;"/>
                            <TextField fx:id="profileNameField" promptText="e.g., Historical Documents"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Description *" style="-fx-font-weight: 600;"/>
                            <TextArea fx:id="profileDescriptionArea" promptText="Describe the type of documents this profile will handle..." prefHeight="80" styleClass="text-area"/>
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Split Logic (Pages) *" style="-fx-font-weight: 600;"/>
                            <TextField fx:id="splitLogicField" promptText="e.g., 5"/>
                        </VBox>
                    </VBox>
                    
                    <HBox spacing="10">
                        <Button text="Create Profile" onAction="#onAddProfileClick" styleClass="button-primary" prefWidth="120"/>
                        <Button text="Clear Form" styleClass="button-secondary" prefWidth="100"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>

        <!-- METADATA TAB -->
        <Tab text="Metadata" closable="false">
            <VBox spacing="20" style="-fx-padding: 20 0 0 0;">
                <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                    <Label text="Metadata Configuration" styleClass="subheader-label"/>
                    <Label text="Define and manage metadata fields for document scanning" style="-fx-text-fill: -text-muted;"/>
                    
                    <VBox spacing="15" styleClass="card" style="-fx-background-color: #f8fafc;">
                        <Label text="Add New Metadata Field" styleClass="card-title"/>
                        <HBox spacing="20" alignment="BOTTOM_LEFT">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Field Name" style="-fx-font-weight: 600;"/>
                                <TextField fx:id="newMetadataFieldName" promptText="e.g., Department, Status"/>
                            </VBox>
                            <Button text="+ Add Field" onAction="#onAddMetadataFieldClick" styleClass="button-primary" prefHeight="38"/>
                        </HBox>
                    </VBox>
                    
                    <Label text="Existing Metadata Fields" style="-fx-font-weight: 600;"/>
                    <ListView fx:id="metadataFieldListView" VBox.vgrow="ALWAYS"/>
                    <Button text="Delete Selected Field" onAction="#onDeleteMetadataFieldClick" styleClass="button-danger" maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </Tab>

        <!-- AUDIT LOGS TAB -->
        <Tab text="Audit Logs" closable="false">
            <VBox spacing="20" style="-fx-padding: 20 0 0 0;">
                <VBox spacing="15" styleClass="card" VBox.vgrow="ALWAYS">
                    <Label text="System Audit Logs" styleClass="subheader-label"/>
                    <Label text="View all system activities and security events" style="-fx-text-fill: -text-muted;"/>
                    
                    <HBox spacing="10">
                        <TextField fx:id="logSearchField" promptText="Search logs..." HBox.hgrow="ALWAYS"/>
                        <Button text="Refresh" onAction="#onRefreshLogsClick" styleClass="button-secondary"/>
                    </HBox>
                    <ListView fx:id="systemLogListView" VBox.vgrow="ALWAYS"/>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
